#!/bin/bash

# archisland:summary=Select and set the system timezone
# archisland:group=menu
# archisland:name=timezone

set -e

timezone=$(timedatectl list-timezones | archisland-menu-select "Set timezone" -- --width 520 --maxheight 520) || exit 1
sudo timedatectl set-timezone "$timezone"
archisland-shell -q archisland.clock refresh
archisland-notification-send "Timezone is now set to $timezone"
