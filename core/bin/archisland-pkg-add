#!/bin/bash

# archisland:summary=Install Arch packages if they are missing
# archisland:args=<packages...>
# archisland:examples=archisland pkg add jq ripgrep
# archisland:requires-sudo=true

if archisland-pkg-missing "$@"; then
  if (( EUID == 0 )); then
    pacman -S --noconfirm --needed -- "$@" || exit 1
  else
    sudo pacman -S --noconfirm --needed -- "$@" || exit 1
  fi
fi

for pkg in "$@"; do
  # Secondary check to handle states where pacman doesn't actually register an error
  if ! pacman -Q -- "$pkg" &>/dev/null; then
    echo -e "\033[31mError: Package '$pkg' did not install\033[0m" >&2
    exit 1
  fi
done

exit 0
