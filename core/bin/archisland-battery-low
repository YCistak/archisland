#!/bin/bash

# archisland:summary=Send the low battery warning notification and run battery-low hooks.
# archisland:args=<percentage>
# archisland:hidden=true

set -euo pipefail

if (($# != 1)); then
  echo "Usage: archisland-battery-low <percentage>" >&2
  exit 1
fi

level=$1

archisland-notification-send -g 󱐋 -u critical "Time to recharge!" "Battery is down to ${level}%" -i battery-caution -t 30000
archisland-hook battery-low "$level"
