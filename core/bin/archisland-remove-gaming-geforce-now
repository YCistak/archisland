#!/bin/bash

# archisland:summary=Remove the GeForce NOW Flatpak app and its data.
# archisland:group=remove
# archisland:name=gaming geforce-now

set -e

if archisland-cmd-present flatpak && flatpak info com.nvidia.geforcenow &>/dev/null; then
  flatpak uninstall -y --delete-data com.nvidia.geforcenow
fi

echo ""
echo "GeForce NOW removed."
