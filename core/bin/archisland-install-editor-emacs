#!/bin/bash

# archisland:summary=Install Emacs with ArchIsland theme and font integration via the archisland-emacs AUR package

echo "Installing Emacs..."
archisland-pkg-aur-add archisland-emacs && archisland-install-emacs

# emacsclient opens a frame on the running daemon, not a second Emacs
setsid uwsm-app -- gtk-launch emacsclient >/dev/null 2>&1 &
