#!/bin/bash

# archisland:summary=Extract text from a screenshot region with OCR
# archisland:group=capture
# archisland:examples=archisland capture text

# Keep hyprpicker alive until after grim captures so the screenshot sees the
# frozen overlay rather than live content shifting during teardown.
cleanup_freeze() {
  [[ -n $PID ]] && kill $PID 2>/dev/null
}
trap cleanup_freeze EXIT

hyprpicker -r -z >/dev/null 2>&1 &
PID=$!
sleep .1
SELECTION=$(slurp 2>/dev/null)

[[ -z $SELECTION ]] && exit 0

TEXT=$(grim -g "$SELECTION" - | tesseract stdin stdout --oem 1 --psm 6 -l "${ARCHISLAND_OCR_LANGS:-tur+eng}" --dpi 300 -c preserve_interword_spaces=1 2>/dev/null) || true

if [[ -z $TEXT ]]; then
  archisland-notification-send -u critical -g 󰴑 "Metin bulunamadı" "Seçilen alanda okunabilir metin tespit edilemedi"
  exit 1
fi

printf "%s" "$TEXT" | wl-copy
archisland-notification-send -g 󰴑 "Metin Panoya Kopyalandı" "$TEXT"
