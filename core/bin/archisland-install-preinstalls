#!/bin/bash

# archisland:summary=Restore the preinstalled ArchIsland applications (web apps, TUIs, and selected packages).
# archisland:requires-sudo=true

if gum confirm "Are you sure you want to restore all preinstalled web apps, TUI wrappers, and desktop applications?"; then
  echo -e "Restoring preinstalled ArchIsland applications...\n"

  # Recreates the shipped .desktop launchers (web apps and TUIs) and the mise stubs
  # that back claude, gh, opencode, and the rest of the agents
  archisland-refresh-applications

  # Mirrors the list in archisland-remove-preinstalls; both track archisland-base.packages
  if ! archisland-pkg-add \
    aether \
    cliamp \
    libreoffice-fresh \
    xournalpp \
    pinta \
    obsidian \
    obs-studio \
    kdenlive \
    moonlight-qt \
    lazydocker \
    omacut \
    monologue \
    omacalc \
    omawrite \
    hype; then
    echo -e "\nPreinstalls are still marked as removed. Fix the errors above and try again."
    exit 1
  fi

  # Last, so a failure above leaves the opt-out intact rather than restoring
  # keybindings for apps that never came back
  rm -f ~/.local/state/archisland/preinstalls-removed
  hyprctl reload
fi
