#!/bin/bash

# archisland:summary=Control the ArchIsland menu (toggle / summon / close / refresh)
# archisland:args=[toggle|summon|close|refresh|ping] [route]
# archisland:examples=archisland menu | archisland menu toggle system | archisland menu summon style.theme | archisland menu refresh

# Thin wrapper around the standard plugin IPC surface. The menu is the
# first-party `archisland.menu` plugin; routes are passed as JSON payload.

set -euo pipefail

verb="${1-toggle}"
route="${2-root}"

menu_payload() {
  jq -nc --arg menu "$1" '{ menu: $menu }'
}

case "$verb" in
  toggle)
    exec archisland-shell shell toggle archisland.menu "$(menu_payload "$route")"
    ;;
  summon)
    exec archisland-shell shell summon archisland.menu "$(menu_payload "$route")"
    ;;
  close)
    exec archisland-shell shell hide archisland.menu
    ;;
  refresh | ping)
    exec archisland-shell shell call archisland.menu "$verb" "{}"
    ;;
  -h | --help | help)
    cat <<USAGE
Usage: archisland menu [verb] [route]

Verbs:
  toggle [route]   Open the menu at <route>, or close it if already open. Default verb.
  summon [route]   Always open the menu (no close-if-visible toggle).
  close            Close the menu if it is visible.
  refresh          Re-parse the menu JSONC files.
  ping             Health check.

Route is an item id (e.g. setup.power) or alias (e.g. power). Defaults to
"root", which opens the top-level menu.
USAGE
    exit 0
    ;;
  *)
    echo "archisland-menu: unknown verb '$verb'. Try 'archisland menu --help'." >&2
    exit 2
    ;;
esac
