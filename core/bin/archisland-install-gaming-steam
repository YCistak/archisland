#!/bin/bash

# archisland:summary=Install Steam and graphics drivers selected for this system
# archisland:requires-sudo=true

set -e

echo "Installing Steam..."
archisland-pkg-add steam
archisland-install-gaming-gpu-lib32

echo ""
echo "Steam will start automatically now. This might take a while..."

setsid uwsm-app -- gtk-launch steam >/dev/null 2>&1 &
