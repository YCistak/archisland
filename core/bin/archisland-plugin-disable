#!/bin/bash

# archisland:summary=Disable a shell plugin
# archisland:group=plugin
# archisland:args=<id>

set -euo pipefail

fail() {
  echo "archisland-plugin-disable: $*" >&2
  exit 1
}

if [[ ${1:-} == "-h" || ${1:-} == "--help" ]]; then
  echo "Usage: archisland plugin disable <id>"
  exit 0
fi

id="${1:-}"
[[ -n $id ]] || fail "plugin id is required"

result=$(archisland-shell shell setPluginEnabled "$id" false)
[[ $result == "ok" ]] ||
  fail "plugin '$id' is not known; run: archisland-shell shell rescanPlugins"

echo "Disabled $id"
