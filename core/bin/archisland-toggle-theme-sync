#!/bin/bash

# archisland:summary=Toggle mirroring theme changes to and from your herdr machines

archisland-toggle herdr-theme-sync

if archisland-toggle-enabled herdr-theme-sync; then
  archisland-notification-send -g 󰸌 "Herdr theme sync enabled"
else
  archisland-notification-send -g 󰸌 "Herdr theme sync disabled"
fi
