#!/bin/bash

# archisland:summary=Install Heroic Games Launcher (Epic, GOG, Amazon Prime Gaming) with graphics drivers.
# archisland:requires-sudo=true

set -e

echo "Installing Heroic Games Launcher..."
archisland-pkg-add heroic-games-launcher-bin
archisland-install-gaming-gpu-lib32

setsid uwsm-app -- gtk-launch heroic >/dev/null 2>&1 &
