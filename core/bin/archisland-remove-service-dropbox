#!/bin/bash

# archisland:summary=Remove Dropbox and its bar plugin.
# archisland:requires-sudo=true

dropbox-cli stop 2>/dev/null || true
archisland-plugin-disable archisland.dropbox
archisland-pkg-drop dropbox dropbox-cli libappindicator-gtk3 python-gpgme nautilus-dropbox

echo ""
echo "Dropbox has been removed."
