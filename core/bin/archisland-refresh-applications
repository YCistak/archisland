#!/bin/bash

# archisland:summary=Ensure default application launchers and mise wrappers are installed.

# Copy .desktop declarations
mkdir -p ~/.local/share/applications
cp "$ARCHISLAND_PATH"/applications/*.desktop ~/.local/share/applications/

if archisland-cmd-present alacritty; then
  cp "$ARCHISLAND_PATH/default/alacritty/Alacritty.desktop" ~/.local/share/applications/
fi

if [[ -f "$ARCHISLAND_PATH/install/user/mise.sh" ]]; then
  bash "$ARCHISLAND_PATH/install/user/mise.sh"
fi

update-desktop-database ~/.local/share/applications
