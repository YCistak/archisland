#!/bin/bash

# archisland:summary=Remove Tailscale and its bar plugin.
# archisland:requires-sudo=true

tailscale down 2>/dev/null || true
systemctl --user disable --now archisland-tailscale-receive.service 2>/dev/null || true
sudo systemctl disable --now tailscaled.service 2>/dev/null || true
archisland-plugin-disable archisland.tailscale
archisland-webapp-remove "Tailscale" 2>/dev/null || true
archisland-pkg-drop tailscale

echo ""
echo "Tailscale has been removed."
