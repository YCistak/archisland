#!/bin/bash

# archisland:summary=Launch a TUI or focus an existing terminal window for it
# archisland:args=[--app-id=<app-id>] <command> [args...]

if [[ ${1:-} == --app-id=* ]]; then
  APP_ID="${1#--app-id=}"
else
  APP_ID="org.archisland.$(basename "$1")"
fi

LAUNCH_COMMAND="archisland-launch-tui $@"

exec archisland-launch-or-focus "$APP_ID" "$LAUNCH_COMMAND"
