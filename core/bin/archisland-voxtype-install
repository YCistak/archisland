#!/bin/bash

# archisland:summary=Install and configure Voxtype dictation
# archisland:requires-sudo=true

set -e

# Install voxtype and configure it for use.

if gum confirm "Install Voxtype + AI model (~150MB) to enable dictation?"; then
  archisland-pkg-add wtype voxtype-bin

  # Setup voxtype
  mkdir -p ~/.config/voxtype
  cp "$ARCHISLAND_PATH/default/voxtype/config.toml" ~/.config/voxtype/

  voxtype setup --download --no-post-install
  if archisland-hw-vulkan; then
    voxtype setup gpu --enable || true
  fi
  voxtype setup systemd

  hyprctl reload >/dev/null
  archisland-restart-shell
  archisland-notification-send -g  "Voxtype Dictation Ready" "Hold F9 to dictate (or toggle with Super + Ctrl + X)." -t 10000
fi
