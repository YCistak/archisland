#!/bin/bash

# archisland:summary=List available themes
# archisland:examples=archisland theme list | archisland theme set "Tokyo Night"

{
  find ~/.config/archisland/themes/ -mindepth 1 -maxdepth 1 \( -type d -o -type l \) -printf '%f\n'
  find "$ARCHISLAND_PATH/themes/" -mindepth 1 -maxdepth 1 -type d -printf '%f\n'
} | sort -u | sed -E 's/(^|-)([a-z])/\1\u\2/g; s/-/ /g'
