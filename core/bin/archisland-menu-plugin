#!/bin/bash

# archisland:summary=Pick a shell plugin to enable, disable, clone, or remove
# archisland:group=menu
# archisland:name=plugin
# archisland:args=<enable|disable|clone|remove>

set -euo pipefail

PLUGIN_ICON=$'\U000f0431'

case "${1:-}" in
  enable) filter='(.enabled | not)' ;;
  disable) filter='.canDisable and .enabled' ;;
  clone) filter='.firstParty and (.id as $id | ($plugins | map(.clonedFrom // "") | index($id)) == null)' ;;
  remove) filter='(.firstParty | not)' ;;
  *)
    echo "Usage: archisland-menu-plugin <enable|disable|clone|remove>" >&2
    exit 1
    ;;
esac

plugins=$(archisland-plugin-list --json)

# The id rides along as row subtext: it tells same-named plugins apart on
# screen and comes back with the selection as the key to act on.
rows=$(jq -r --arg icon "$PLUGIN_ICON" \
  ". as \$plugins
   | .[] | select($filter)
   | \$icon + \"\\t\" + .name + \"\\t\" + .id" <<<"$plugins")
[[ -n $rows ]] || { archisland-notification-send "No plugin to ${1}"; exit 0; }

selection=$(archisland-menu-select "${1^} plugin" <<<"$rows") || exit 0
[[ -n $selection ]] || exit 0

id=$(cut -f2 <<<"$selection")
[[ -n $id ]] || exit 1

if [[ $1 == "clone" ]]; then
  archisland-launch-floating-terminal-with-presentation \
    "archisland-plugin-clone $(printf '%q' "$id") --edit"
elif [[ $1 == "remove" ]]; then
  archisland-launch-floating-terminal-with-presentation "archisland-plugin-remove $(printf '%q' "$id")"
else
  "archisland-plugin-$1" "$id"
fi
