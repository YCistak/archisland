#!/bin/bash

# archisland:summary=Toggle crash capture notifications

# nf-md-robot_dead, escaped so this file reads without a Nerd Font.
readonly CRASH_GLYPH=$'\U000f16a1'

archisland-toggle crash-capture-off

# The unit checks the same flag with ConditionPathExists, so stopping and
# starting only settles this session; the next login reads the flag itself.
if archisland-toggle-enabled crash-capture-off; then
  systemctl --user stop archisland-crash-watch.service
  archisland-notification-send -g "$CRASH_GLYPH" "Crash capture disabled"
else
  systemctl --user start archisland-crash-watch.service
  archisland-notification-send -g "$CRASH_GLYPH" "Crash capture enabled"
fi
