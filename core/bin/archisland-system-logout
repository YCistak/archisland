#!/bin/bash

# archisland:summary=Log out after closing application windows
# archisland:examples=archisland logout | archisland system logout
# archisland:aliases=archisland logout

nohup bash -c "sleep 2 && uwsm stop" >/dev/null 2>&1 &

archisland-osd -i logout -m "Logging out" -d 5000

# Now close all windows
archisland-hyprland-window-close-all
sleep 1 # Allow apps like Chrome to shutdown correctly
