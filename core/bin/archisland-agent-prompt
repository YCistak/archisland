#!/bin/bash

# archisland:summary=Launch the default coding agent with a prompt
# archisland:args=[--inline] <prompt...>
# archisland:examples=archisland agent prompt "Review this project"

# Prompts live here rather than on `archisland agent`, where a bare prompt would
# shadow the subcommands under that group.

set -euo pipefail

inline=()
if [[ ${1:-} == "--inline" ]]; then
  inline=(--inline)
  shift
fi

if (($# == 0)); then
  echo "Usage: archisland agent prompt [--inline] <prompt...>" >&2
  exit 1
fi

exec archisland-agent "${inline[@]}" --prompt "$*"
