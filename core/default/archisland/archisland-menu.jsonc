{
  // ArchIsland menu definition.
  // JSONC is used for Neovim-friendly highlighting, comments, and trailing commas.
  // IDs are object keys. Dotted IDs imply hierarchy: trigger.share.file belongs
  // under trigger.share.
  // Kind is inferred: action -> action, target -> link, otherwise submenu.
  // Dotted IDs define the tree. provider:"name" points a submenu at one of
  // the shell's providers (the providers map in shell/plugins/menu/Menu.qml);
  // new provider names cannot be declared here. See docs/menu.md.
  // Optional fields:
  //   aliases        alternate `archisland menu summon <name>` routes; also searchable.
  //                  Reserved for established names users already type; new entries
  //                  should not normally add any.
  //   iconFont       font family used for the icon glyph, when it differs from the menu font
  //   title          header text shown when the submenu is open; defaults to label
  //   when           shell condition; hide row when it fails
  //   checked        shell condition; append ✓ when it succeeds
  //   disabled       shell condition; when it succeeds the row stays listed but
  //                  goes dim, takes a ✓ and can no longer be selected. Install
  //                  rows use it so software already on the machine reads as
  //                  installed instead of vanishing from the list.

  // Root Menu
  "apps": {"icon":"󰀻","label":"Apps","aliases":["app","applications"],"provider":"apps"},
  "learn": {"icon":"󰧑","label":"Learn"},
  "trigger": {"icon":"󱓞","label":"Trigger"},
  "style": {"icon":"","label":"Style"},
  "setup": {"icon":"","label":"Setup","aliases":["settings"]},
  "install": {"icon":"󰉉","label":"Install"},
  "remove": {"icon":"󰭌","label":"Remove","aliases":["uninstall"]},
  "update": {"icon":"","label":"Update","aliases":["restart","refresh"]},
  "about": {"icon":"","label":"About","action":"archisland-launch-about"},
  "system": {"icon":"","label":"System","aliases":["power-menu"]},

  // System
  "system.screensaver": {"icon":"󱄄","label":"Screensaver","action":"archisland-launch-screensaver force"},
  "system.lock": {"icon":"","label":"Lock","action":"archisland-system-lock"},
  "system.suspend": {"icon":"󰒲","label":"Suspend","when":"! archisland-toggle-enabled suspend-off","action":"systemctl suspend"},
  "system.hibernate": {"icon":"󰤁","label":"Hibernate","when":"archisland-hibernation-available","action":"systemctl hibernate"},
  "system.logout": {"icon":"󰍃","label":"Logout","action":"archisland-system-logout"},
  "system.reboot": {"icon":"󰜉","label":"Reboot","action":"archisland-system-reboot"},
  "system.shutdown": {"icon":"󰐥","label":"Shutdown","action":"archisland-system-shutdown"},

  // Learn
  "learn.keybindings": {"icon":"","label":"Keybindings","action":"archisland-menu-keybindings"},
  "learn.hyprland": {"icon":"","label":"Hyprland","action":"archisland-launch-webapp 'https://wiki.hypr.land/'"},
  "learn.arch": {"icon":"󰣇","label":"Arch","action":"archisland-launch-webapp 'https://wiki.archlinux.org/title/Main_page'"},
  "learn.neovim": {"icon":"","label":"Neovim","action":"archisland-launch-webapp 'https://www.lazyvim.org/keymaps'"},
  "learn.bash": {"icon":"󱆃","label":"Bash","action":"archisland-launch-webapp 'https://devhints.io/bash'"},
  "learn.tmux-keybindings": {"icon":"","label":"Tmux","action":"archisland-menu-tmux-keybindings"},
  "learn.herdr-keybindings": {"icon":"","label":"Herdr","action":"archisland-menu-herdr-keybindings"},

  // Trigger
  "trigger.emoji": {"icon":"","label":"Emoji","aliases":["emoji","emojis"],"action":"archisland-menu-emoji"},
  "trigger.reminder": {"icon":"󰢌","label":"Reminder","aliases":["reminder"]},
  "trigger.capture": {"icon":"","label":"Capture","aliases":["capture","screenshot","screenrecord","screen-record","screenrecording"]},
  "trigger.capture.screenshot": {"icon":"","label":"Screenshot","action":"archisland-capture-screenshot"},
  "trigger.capture.screenrecord.stop": {"icon":"","label":"Stop Screenrecording","when":"pgrep -f '^gpu-screen-recorder'","action":"archisland-capture-screenrecording --stop-recording"},
  "trigger.capture.screenrecord": {"icon":"","label":"Screenrecord"},
  "trigger.capture.text": {"icon":"󰴑","label":"Text","action":"archisland-capture-text"},
  "trigger.capture.qr": {"icon":"󰐲","label":"QR Code","action":"archisland-capture-qr"},
  "trigger.capture.color": {"icon":"󰃉","label":"Color","action":"pkill hyprpicker || hyprpicker -a -n"},
  "trigger.capture.screenrecord.no-audio": {"icon":"","label":"With no audio","action":"archisland-capture-screenrecording"},
  "trigger.capture.screenrecord.desktop-audio": {"icon":"","label":"With desktop audio","action":"archisland-capture-screenrecording --with-desktop-audio"},
  "trigger.capture.screenrecord.microphone": {"icon":"","label":"With desktop + microphone audio","action":"archisland-capture-screenrecording --with-desktop-audio --with-microphone-audio"},
  "trigger.capture.screenrecord.webcam": {"icon":"","label":"With desktop + microphone audio + webcam","when":"archisland-hw-webcam","action":"archisland-capture-screenrecording-with-webcam"},
  "trigger.transcode": {"icon":"󰧸","label":"Transcode","action":"archisland-transcode"},
  "trigger.share": {"icon":"","label":"Share","aliases":["share"]},
  "trigger.toggle": {"icon":"󰔎","label":"Toggle","aliases":["toggle","toggles"]},
  "trigger.hardware": {"icon":"","label":"Hardware","aliases":["hardware","hw"]},
  "trigger.tests": {"icon":"󰓅","label":"Speed Test"},
  "trigger.hardware.laptop-display": {"icon":"󰛧","label":"Laptop Display","when":"archisland-hw-laptop","action":"archisland-hyprland-monitor-internal toggle"},
  "trigger.hardware.mirror-display": {"icon":"󰍹","label":"Mirror Display","when":"archisland-hw-laptop","action":"archisland-hyprland-monitor-internal-mirror toggle"},
  "trigger.hardware.hybrid-gpu": {"icon":"","label":"Hybrid GPU","when":"archisland-hw-hybrid-gpu","action":"archisland-launch-floating-terminal-with-presentation archisland-toggle-hybrid-gpu"},
  "trigger.hardware.touchpad": {"icon":"󰟸","label":"Touchpad","when":"archisland-hw-touchpad","action":"archisland-toggle-touchpad"},
  "trigger.hardware.touchpad-haptics": {"icon":"󰌌","label":"Touchpad Haptics"},
  "trigger.hardware.touchpad-haptics.low": {"icon":"󰌌","label":"low","when":"archisland-hw-dell-xps-haptic-touchpad && archisland-cmd-present dell-xps-touchpad-haptics","checked":"[[ \"$(dell-xps-touchpad-haptics get)\" == \"low\" ]]","action":"dell-xps-touchpad-haptics set low"},
  "trigger.hardware.touchpad-haptics.mid": {"icon":"󰌌","label":"mid","when":"archisland-hw-dell-xps-haptic-touchpad && archisland-cmd-present dell-xps-touchpad-haptics","checked":"[[ \"$(dell-xps-touchpad-haptics get)\" == \"mid\" ]]","action":"dell-xps-touchpad-haptics set mid"},
  "trigger.hardware.touchpad-haptics.high": {"icon":"󰌌","label":"high","when":"archisland-hw-dell-xps-haptic-touchpad && archisland-cmd-present dell-xps-touchpad-haptics","checked":"[[ \"$(dell-xps-touchpad-haptics get)\" == \"high\" ]]","action":"dell-xps-touchpad-haptics set high"},
  "trigger.hardware.touchscreen": {"icon":"󰆽","label":"Touchscreen","when":"archisland-hw-touchscreen","action":"archisland-toggle-touchscreen"},
  "trigger.reminder.set": {"icon":"󰢌","label":"Set one","aliases":["reminder-set","remind"],"action":"archisland-reminder -i"},
  "trigger.reminder.show": {"icon":"󰢌","label":"Show all","action":"archisland-reminder show"},
  "trigger.reminder.clear": {"icon":"󰢌","label":"Clear all","action":"archisland-reminder clear"},
  "trigger.share.clipboard": {"icon":"","label":"Clipboard","action":"archisland-menu-share clipboard"},
  "trigger.share.file": {"icon":"","label":"File","action":"archisland-menu-share file"},
  "trigger.share.folder": {"icon":"","label":"Folder","action":"archisland-menu-share folder"},
  "trigger.share.receive": {"icon":"󰥦","label":"Receive","action":"archisland-menu-share receive"},
  "trigger.toggle.idle-lock": {"icon":"󰅶","label":"Stay Awake","action":"archisland-toggle-idle"},
  "trigger.toggle.notifications": {"icon":"󰂛","label":"Notifications","action":"archisland-toggle-notification-silencing"},
  "trigger.toggle.crash-capture": {"icon":"󱚡","label":"Crash Capture","action":"archisland-toggle-crash-capture"},
  "trigger.toggle.screensaver": {"icon":"󱄄","label":"Screensaver","action":"archisland-toggle-screensaver"},
  "trigger.toggle.nightlight": {"icon":"󰔎","label":"Nightlight","action":"archisland-toggle-nightlight"},
  "trigger.toggle.top-bar": {"icon":"󰍜","label":"Menu Bar","action":"archisland-toggle-bar"},
  "trigger.toggle.battery-percentage": {"icon":"󰁹","label":"Battery Percentage","when":"archisland-hw-laptop","action":"archisland-shell archisland.power togglePercentage"},
  "trigger.toggle.workspace-layout": {"icon":"󱂬","label":"Workspace Layout","action":"archisland-hyprland-workspace-layout-toggle"},
  "trigger.toggle.window-gaps": {"icon":"","label":"Window Gaps","action":"archisland-hyprland-window-gaps-toggle"},
  "trigger.toggle.animations": {"icon":"󰕟","label":"Animations","action":"archisland-toggle-animations"},
  "trigger.toggle.one-window-ratio": {"icon":"","label":"1-Window Ratio","action":"archisland-hyprland-window-single-square-aspect-toggle"},
  "trigger.tests.network-speedtest": {"icon":"󰓅","label":"Network Speed Test","action":"archisland-shell shell summon archisland.speedtest"},
  "trigger.tests.disk-speedtest": {"icon":"󰋊","label":"Disk Speed Test","action":"archisland-shell shell summon archisland.disk-speedtest"},

  // Style
  "style.bar": {"icon":"󰍜","label":"Menu Bar"},
  "style.bar.position": {"icon":"","label":"Position"},
  "style.bar.transparency": {"icon":"󰂵","label":"Transparency","action":"archisland-bar transparent toggle"},
  "style.hyprland": {"icon":"","label":"Hyprland","action":"archisland-launch-config-editor \"$HOME/.config/hypr/looknfeel.lua\""},
  "style.bar.position.top": {"icon":"󰁝","label":"Top","action":"archisland-bar position top"},
  "style.bar.position.bottom": {"icon":"󰁅","label":"Bottom","action":"archisland-bar position bottom"},
  "style.bar.position.left": {"icon":"󰁍","label":"Left","action":"archisland-bar position left"},
  "style.bar.position.right": {"icon":"󰁔","label":"Right","action":"archisland-bar position right"},

  // Setup
  "setup.monitors": {"icon":"󰍹","label":"Monitors","action":"archisland-launch-config-editor \"$HOME/.config/hypr/monitors.lua\""},
  "setup.keybindings": {"icon":"","label":"Keybindings","when":"[[ -f ~/.config/hypr/bindings.lua ]]","action":"archisland-launch-config-editor \"$HOME/.config/hypr/bindings.lua\""},
  "setup.input": {"icon":"","label":"Input","when":"[[ -f ~/.config/hypr/input.lua ]]","action":"archisland-launch-config-editor \"$HOME/.config/hypr/input.lua\""},
  "setup.network": {"icon":"󰛳","label":"Network","aliases":["network"]},
  "setup.network.dns": {"icon":"󰇖","label":"DNS","aliases":["dns"]},
  "setup.network.dns.dhcp": {"icon":"󰩟","label":"DHCP","checked":"[[ \"$(archisland-dns)\" == \"DHCP\" ]]","action":"archisland-dns DHCP"},
  "setup.network.dns.cloudflare": {"icon":"󰅟","label":"Cloudflare","checked":"[[ \"$(archisland-dns)\" == \"Cloudflare\" ]]","action":"archisland-dns Cloudflare"},
  "setup.network.dns.google": {"icon":"󰊭","label":"Google","checked":"[[ \"$(archisland-dns)\" == \"Google\" ]]","action":"archisland-dns Google"},
  "setup.network.dns.custom": {"icon":"","label":"Custom","checked":"[[ \"$(archisland-dns)\" == \"Custom\" ]]","action":"archisland-launch-floating-terminal-with-presentation 'archisland-dns Custom'"},
  "setup.network.qr": {"icon":"󰐲","label":"QR Code","aliases":["wifi-qr"],"when":"[[ $(archisland-network-status) == wifi* ]]","action":"archisland-shell shell summon archisland.wifiqr"},
  "setup.default": {"icon":"","label":"Defaults","aliases":["default","defaults"]},
  "setup.default.agent": {"icon":"󰚩","label":"Agent","title":"Default Agent"},
  "setup.default.agent.agy": {"icon":"󰫢","label":"Antigravity","checked":"[[ \"$(archisland-default-agent)\" == \"agy\" ]]","action":"archisland-default-agent agy"},
  "setup.default.agent.claude": {"icon":"󰛄","label":"Claude","checked":"[[ \"$(archisland-default-agent)\" == \"claude\" ]]","action":"archisland-default-agent claude"},
  "setup.default.agent.codex": {"icon":"","iconFont":"archisland","label":"Codex","checked":"[[ \"$(archisland-default-agent)\" == \"codex\" ]]","action":"archisland-default-agent codex"},
  "setup.default.agent.copilot": {"icon":"","label":"Copilot","checked":"[[ \"$(archisland-default-agent)\" == \"copilot\" ]]","action":"archisland-default-agent copilot"},
  "setup.default.agent.crush": {"icon":"󰋑","label":"Crush","checked":"[[ \"$(archisland-default-agent)\" == \"crush\" ]]","action":"archisland-default-agent crush"},
  "setup.default.agent.cursor-agent": {"icon":"","iconFont":"archisland","label":"Cursor CLI","checked":"[[ \"$(archisland-default-agent)\" == \"cursor-agent\" ]]","action":"archisland-default-agent cursor-agent"},
  "setup.default.agent.grok": {"icon":"","iconFont":"archisland","label":"Grok","checked":"[[ \"$(archisland-default-agent)\" == \"grok\" ]]","action":"archisland-default-agent grok"},
  "setup.default.agent.hermes": {"icon":"","iconFont":"archisland","label":"Hermes","checked":"[[ \"$(archisland-default-agent)\" == \"hermes\" ]]","action":"archisland-default-agent hermes"},
  "setup.default.agent.muse": {"icon":"󰛤","label":"Muse Code","checked":"[[ \"$(archisland-default-agent)\" == \"muse\" ]]","action":"archisland-default-agent muse"},
  "setup.default.agent.omp": {"icon":"","iconFont":"archisland","label":"omp","checked":"[[ \"$(archisland-default-agent)\" == \"omp\" ]]","action":"archisland-default-agent omp"},
  "setup.default.agent.openclaw": {"icon":"","iconFont":"archisland","label":"OpenClaw","checked":"[[ \"$(archisland-default-agent)\" == \"openclaw\" ]]","action":"archisland-default-agent openclaw"},
  "setup.default.agent.opencode": {"icon":"","iconFont":"archisland","label":"OpenCode","checked":"[[ \"$(archisland-default-agent)\" == \"opencode\" ]]","action":"archisland-default-agent opencode"},
  "setup.default.agent.ori": {"icon":"","iconFont":"archisland","label":"Ori","checked":"[[ \"$(archisland-default-agent)\" == \"ori\" ]]","action":"archisland-default-agent ori"},
  "setup.default.agent.pi": {"icon":"","iconFont":"archisland","label":"Pi","checked":"[[ \"$(archisland-default-agent)\" == \"pi\" ]]","action":"archisland-default-agent pi"},
  "setup.default.browser": {"icon":"","label":"Browser","title":"Default Browser"},
  "setup.default.browser.chromium": {"icon":"","label":"Chromium","checked":"[[ \"$(archisland-default-browser)\" == \"chromium\" ]]","action":"archisland-default-browser chromium"},
  "setup.default.browser.chrome": {"icon":"󰊯","label":"Chrome","checked":"[[ \"$(archisland-default-browser)\" == \"chrome\" ]]","action":"archisland-default-browser chrome"},
  "setup.default.browser.brave": {"icon":"󰖟","label":"Brave","checked":"[[ \"$(archisland-default-browser)\" == \"brave\" ]]","action":"archisland-default-browser brave"},
  "setup.default.browser.brave-origin": {"icon":"󰖟","label":"Brave Origin","checked":"[[ \"$(archisland-default-browser)\" == \"brave-origin\" ]]","action":"archisland-default-browser brave-origin"},
  "setup.default.browser.edge": {"icon":"󰇩","label":"Edge","checked":"[[ \"$(archisland-default-browser)\" == \"edge\" ]]","action":"archisland-default-browser edge"},
  "setup.default.browser.firefox": {"icon":"","label":"Firefox","checked":"[[ \"$(archisland-default-browser)\" == \"firefox\" ]]","action":"archisland-default-browser firefox"},
  "setup.default.browser.zen": {"icon":"󰖟","label":"Zen","checked":"[[ \"$(archisland-default-browser)\" == \"zen\" ]]","action":"archisland-default-browser zen"},
  "setup.default.terminal": {"icon":"","label":"Terminal","title":"Default Terminal"},
  "setup.default.terminal.alacritty": {"icon":"","label":"Alacritty","checked":"[[ \"$(archisland-default-terminal)\" == \"alacritty\" ]]","action":"archisland-default-terminal alacritty"},
  "setup.default.terminal.foot": {"icon":"","label":"Foot","checked":"[[ \"$(archisland-default-terminal)\" == \"foot\" ]]","action":"archisland-default-terminal foot"},
  "setup.default.terminal.ghostty": {"icon":"","label":"Ghostty","checked":"[[ \"$(archisland-default-terminal)\" == \"ghostty\" ]]","action":"archisland-default-terminal ghostty"},
  "setup.default.terminal.kitty": {"icon":"","label":"Kitty","checked":"[[ \"$(archisland-default-terminal)\" == \"kitty\" ]]","action":"archisland-default-terminal kitty"},
  "setup.default.editor": {"icon":"","label":"Editor","title":"Default Editor"},
  "setup.default.editor.neovim": {"icon":"","label":"Neovim","checked":"[[ \"$(archisland-default-editor)\" == \"nvim\" ]]","action":"archisland-default-editor nvim"},
  "setup.default.editor.vscode": {"icon":"","label":"VSCode","checked":"[[ \"$(archisland-default-editor)\" == \"code\" ]]","action":"archisland-default-editor code"},
  "setup.default.editor.cursor": {"icon":"","iconFont":"archisland","label":"Cursor","checked":"[[ \"$(archisland-default-editor)\" == \"cursor\" ]]","action":"archisland-default-editor cursor"},
  "setup.default.editor.zed": {"icon":"","label":"Zed","checked":"[[ \"$(archisland-default-editor)\" == \"zeditor\" ]]","action":"archisland-default-editor zed"},
  "setup.default.editor.sublime": {"icon":"","label":"Sublime Text","checked":"[[ \"$(archisland-default-editor)\" == \"subl\" ]]","action":"archisland-default-editor sublime_text"},
  "setup.default.editor.helix": {"icon":"","label":"Helix","checked":"[[ \"$(archisland-default-editor)\" == \"helix\" ]]","action":"archisland-default-editor helix"},
  "setup.default.editor.vim": {"icon":"","label":"Vim","checked":"[[ \"$(archisland-default-editor)\" == \"vim\" ]]","action":"archisland-default-editor vim"},
  "setup.default.editor.emacs": {"icon":" ","label":"Emacs","checked":"[[ \"$(archisland-default-editor)\" == \"emacs\" ]]","action":"archisland-default-editor emacs"},
  "setup.plugin": {"icon":"󰐱","label":"Plugins","aliases":["plugin","plugins"]},
  "setup.plugin.enable": {"icon":"󰄬","label":"Enable Plugin","action":"archisland-menu-plugin enable"},
  "setup.plugin.disable": {"icon":"󰅖","label":"Disable Plugin","action":"archisland-menu-plugin disable"},
  "setup.plugin.add": {"icon":"󰖟","label":"Add Plugin","action":"archisland-launch-floating-terminal-with-presentation 'archisland-plugin-add'"},
  "setup.plugin.clone": {"icon":"󰆏","label":"Clone Plugin","action":"archisland-menu-plugin clone"},
  "setup.plugin.remove": {"icon":"󰭌","label":"Remove Plugin","when":"compgen -G \"$HOME/.config/archisland/plugins/*/manifest.json\"","action":"archisland-menu-plugin remove"},
  "setup.security": {"icon":"","label":"Security"},
  "setup.config": {"icon":"","label":"Config"},
  "setup.security.fingerprint": {"icon":"󰈷","label":"Fingerprint","when":"archisland-hw-fingerprint","action":"archisland-launch-floating-terminal-with-presentation archisland-setup-security-fingerprint"},
  "setup.security.fido2": {"icon":"","label":"Fido2","action":"archisland-launch-floating-terminal-with-presentation archisland-setup-security-fido2"},
  "setup.security.sshd": {"icon":"󰣀","label":"SSHD","action":"archisland-launch-floating-terminal-with-presentation archisland-setup-security-sshd"},
  "setup.security.ssh-agent": {"icon":"󰣀","label":"SSH Agent","when":"! systemctl --user -q is-enabled gcr-ssh-agent.socket","action":"archisland-launch-floating-terminal-with-presentation archisland-setup-security-ssh-agent"},
  "setup.security.passwordless-sudo": {"icon":"󰟵","label":"Passwordless Sudo","action":"archisland-launch-floating-terminal-with-presentation archisland-sudo-passwordless"},
  "setup.security.sudoless-docker": {"icon":"󰡨","label":"Sudoless Docker","when":"archisland-sudo-docker --configured","action":"archisland-launch-floating-terminal-with-presentation archisland-setup-security-sudoless-docker"},
  "setup.config.hyprland": {"icon":"","label":"Hyprland","action":"archisland-launch-config-editor \"$HOME/.config/hypr/hyprland.lua\""},
  "setup.config.hyprsunset": {"icon":"","label":"Hyprsunset","action":"archisland-launch-config-editor ~/.config/hypr/hyprsunset.conf && archisland-restart-hyprsunset"},
  "setup.config.xcompose": {"icon":"󰞅","label":"XCompose","action":"archisland-launch-config-editor ~/.XCompose && archisland-restart-xcompose"},

  // Install
  "install.package": {"icon":"󰣇","label":"Package","action":"xdg-terminal-exec --app-id=org.archisland.terminal archisland-pkg-install"},
  "install.ai": {"icon":"󱚤","label":"AI"},
  "install.service": {"icon":"","label":"Service"},
  "install.development": {"icon":"󰵮","label":"Development"},
  "install.editor": {"icon":"","label":"Editor"},
  "install.gaming": {"icon":"","label":"Gaming"},
  "install.browser": {"icon":"","label":"Browser"},
  "install.webapp": {"icon":"","label":"Web App","action":"archisland-launch-floating-terminal-with-presentation archisland-webapp-install"},
  "install.terminal": {"icon":"","label":"Terminal"},
  "install.tui": {"icon":"","label":"TUI","action":"archisland-launch-floating-terminal-with-presentation archisland-tui-install"},
  "install.aur": {"icon":"󰣇","label":"AUR","action":"xdg-terminal-exec --app-id=org.archisland.terminal archisland-pkg-aur-install"},
  "install.preinstalls": {"icon":"󰏓","label":"Preinstalls","disabled":"[[ ! -f $HOME/.local/state/archisland/preinstalls-removed ]]","action":"archisland-launch-floating-terminal-with-presentation archisland-install-preinstalls"},
  "install.browser.chrome": {"icon":"","label":"Chrome","disabled":"archisland-pkg-present google-chrome","action":"archisland-launch-floating-terminal-with-presentation 'archisland-install-browser chrome'"},
  "install.browser.edge": {"icon":"󰇩","label":"Edge","disabled":"archisland-pkg-present microsoft-edge-stable-bin","action":"archisland-launch-floating-terminal-with-presentation 'archisland-install-browser edge'"},
  "install.browser.brave": {"icon":"","label":"Brave","disabled":"archisland-pkg-present brave-bin","action":"archisland-launch-floating-terminal-with-presentation 'archisland-install-browser brave'"},
  "install.browser.brave-origin": {"icon":"","label":"Brave Origin","disabled":"archisland-pkg-present brave-origin-bin","action":"archisland-launch-floating-terminal-with-presentation 'archisland-install-browser brave-origin'"},
  "install.browser.firefox": {"icon":"","label":"Firefox","disabled":"archisland-pkg-present firefox","action":"archisland-launch-floating-terminal-with-presentation 'archisland-install-browser firefox'"},
  "install.browser.zen": {"icon":"󰖟","label":"Zen","disabled":"archisland-pkg-present zen-browser-bin","action":"archisland-launch-floating-terminal-with-presentation 'archisland-install-browser zen'"},
  "install.service.1password": {"icon":"󰢁","label":"1Password","disabled":"archisland-pkg-present 1password","action":"archisland-launch-floating-terminal-with-presentation archisland-install-service-1password"},
  "install.service.dropbox": {"icon":"","label":"Dropbox","disabled":"archisland-pkg-present dropbox","action":"archisland-launch-floating-terminal-with-presentation archisland-install-service-dropbox"},
  "install.service.spotify": {"icon":"󰓇","label":"Spotify","disabled":"archisland-pkg-present spotify","action":"archisland-launch-floating-terminal-with-presentation archisland-install-service-spotify"},
