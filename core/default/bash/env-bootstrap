# Single source of truth for ARCHISLAND_PATH + PATH adjustments. Sourced by:
#   /etc/profile.d/archisland.sh                 (system login shells)
#   /etc/skel/.bashrc                         (interactive shells)
#   /usr/share/uwsm/env.d/10-archisland          (Hyprland session via uwsm)
#   /usr/share/archisland/default/bash/envs      (bash rc chain; SSH/non-login)

# /etc/archisland.conf is written by archisland-dev-link and reset by
# archisland-dev-unlink. When absent, force the packaged default instead of
# preserving a stale inherited value.
if [ -f /etc/archisland.conf ]; then
  . /etc/archisland.conf
  : "${ARCHISLAND_PATH:=/usr/share/archisland}"
else
  ARCHISLAND_PATH=/usr/share/archisland
fi
export ARCHISLAND_PATH

# Only prepend in dev-link mode. On a production install, the binaries are
# already on PATH as /usr/bin/archisland-* via the archisland package — prepending
# /usr/share/archisland/bin would just be noise.
if [ "$ARCHISLAND_PATH" != /usr/share/archisland ]; then
  case ":$PATH:" in
    *":${ARCHISLAND_PATH%/}/bin:"*) ;;
    *) PATH="${ARCHISLAND_PATH%/}/bin${PATH:+:$PATH}" ;;
  esac
fi

# User-level tool paths, appended so system binaries keep precedence. This is
# what lets login shells (ssh, bash -lc) and the uwsm session find mise-managed
# tools without an interactive rc. Keep these directories in sync with the PAM
# PATH line from install/config/ssh-command-path.sh, which covers SSH commands
# that run no shell setup at all.
case ":$PATH:" in
  *":$HOME/.local/share/mise/shims:"*) ;;
  *) PATH="${PATH:+$PATH:}$HOME/.local/share/mise/shims" ;;
esac
case ":$PATH:" in
  *":$HOME/.local/bin:"*) ;;
  *) PATH="${PATH:+$PATH:}$HOME/.local/bin" ;;
esac
export PATH
