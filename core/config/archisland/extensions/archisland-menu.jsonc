{
  "about": {"when": "false"},
  "learn": {"when": "false"},
  "apps": {"when": "false"},
  "system": {"when": "false"},
  "update": {"when": "false"},
  "update.archisland": {"when": "false"},
  "remove": {"when": "false"},
  "install": {"when": "false"},
  "setup": {"when": "false"},
  "trigger": {"when": "false"},
  "style": {"when": "false"},

  // Trigger altındaki öğeleri ana menüye (root) çıkarma
  "trigger.capture": {"parent": "root"},
  "trigger.toggle": {"parent": "root"},
  "trigger.share": {"parent": "root"},
  "trigger.reminder": {"parent": "root"},
  "trigger.transcode": {"parent": "root"},
  "trigger.tests": {"parent": "root"},

  // Ana Menü Girdileri
  "dev": {
    "icon": "",
    "label": "Geliştirici & AI Kota",
    "aliases": ["dev", "island-dev", "developer"],
    "action": "/home/asaf/.local/bin/island show dev"
  },
  "ocr": {
    "icon": "󰴑",
    "label": "OCR & Ekran Çeviri",
    "aliases": ["ocr", "ocr-translate", "translate"],
    "action": "ocr-translate"
  },

  // Style fixes
  "style.about": {"when": "false"},
  "style.theme": {"icon":"󰸌","label":"Theme","aliases":["theme","themes"],"action":"archisland-shell guilhermerisu.island themes"},
  "style.background": {"icon":"","label":"Background","aliases":["background","wallpaper"],"action":"archisland-shell guilhermerisu.island wallpapers"},
  "style.bar": {"when": "false"},
  "style.island": {"icon":"󰍜","label":"Island Settings","parent":"style","action":"archisland-shell guilhermerisu.island show settings"},
  "style.hyprland": {"icon":"","label":"Hyprland","action":"archisland-launch-config-editor \"$HOME/.config/hypr/hyprland.lua\""},

  // Setup fixes
  "setup.monitors": {"icon":"󰍹","label":"Monitors","action":"archisland-launch-config-editor \"$HOME/.config/hypr/hyprland.lua\""},
  "setup.keybindings": {"icon":"","label":"Keybindings","action":"archisland-shell guilhermerisu.island show keybinds"},
  "setup.input": {"icon":"","label":"Input","action":"archisland-launch-config-editor \"$HOME/.config/hypr/hyprland.lua\""},

  // Trigger / Toggle gizlemeleri
  "trigger.emoji": {"when": "false"},
  "trigger.toggle.screensaver": {"when": "false"},
  "trigger.toggle.animations": {"when": "false"},
  "trigger.toggle.top-bar": {"when": "false"},

  // Install detection fixes (recognize system packages and local runtimes)
  "install.development.python": {"disabled": "archisland-cmd-present python || [[ -d $HOME/.local/share/mise/installs/python ]]"},
  "install.development.javascript.node": {"disabled": "archisland-cmd-present node || [[ -d $HOME/.local/share/mise/installs/node ]]"},
  "install.development.go": {"disabled": "archisland-cmd-present go || [[ -d $HOME/.local/share/mise/installs/go ]]"},
  "install.development.rust": {"disabled": "archisland-cmd-present rustc || [[ -d $HOME/.rustup ]]"},
  "install.development.java": {"disabled": "archisland-cmd-present java || [[ -d $HOME/.local/share/mise/installs/java ]]"},
  "install.development.dotnet": {"disabled": "archisland-cmd-present dotnet || [[ -d $HOME/.local/share/mise/installs/dotnet ]]"},
  "install.development.javascript.bun": {"disabled": "archisland-cmd-present bun || [[ -d $HOME/.local/share/mise/installs/bun ]]"},
  "install.development.javascript.deno": {"disabled": "archisland-cmd-present deno || [[ -d $HOME/.local/share/mise/installs/deno ]]"},
  "install.development.php.php": {"disabled": "archisland-cmd-present php || [[ -d $HOME/.local/share/mise/installs/php ]]"},
  "install.development.zig": {"disabled": "archisland-cmd-present zig || [[ -d $HOME/.local/share/mise/installs/zig ]]"},
  "install.style.font.meslo": {"disabled": "fc-list : family | grep -qi meslo"},
  "install.gaming.steam": {"disabled": "archisland-cmd-present steam || archisland-pkg-present steam"},

  // Portal & Last Session
  "dev.portal": {"icon":"󰛳","label":"Portal (Dev Ports & Tunnels)","action":"/home/asaf/.local/bin/island portal"},
  "setup.config.last-session": {"icon":"󰁯","label":"Last Session Config","action":"~/.config/archisland/plugins/io.github.asmyshlyaev177.last-session/bin/archisland-last-session config"},
  "system.logout": {"icon":"󰍃","label":"Logout","action":"[[ -x ~/.config/archisland/plugins/io.github.asmyshlyaev177.last-session/bin/archisland-last-session ]] && ~/.config/archisland/plugins/io.github.asmyshlyaev177.last-session/bin/archisland-last-session shutdown; archisland-system-logout"},
  "system.reboot": {"icon":"󰜉","label":"Reboot","action":"[[ -x ~/.config/archisland/plugins/io.github.asmyshlyaev177.last-session/bin/archisland-last-session ]] && ~/.config/archisland/plugins/io.github.asmyshlyaev177.last-session/bin/archisland-last-session shutdown; archisland-system-reboot"},
  "system.shutdown": {"icon":"󰐥","label":"Shutdown","action":"[[ -x ~/.config/archisland/plugins/io.github.asmyshlyaev177.last-session/bin/archisland-last-session ]] && ~/.config/archisland/plugins/io.github.asmyshlyaev177.last-session/bin/archisland-last-session shutdown; archisland-system-shutdown"}
}
