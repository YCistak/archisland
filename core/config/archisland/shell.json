{
  "version": 1,
  "idle": {
    "screensaver": 150,
    "lock": 300
  },
  "bar": {
    "position": "top",
    "transparent": false,
    "centerAnchor": "archisland.clock",
    "layout": {
      "left": [
        {
          "id": "archisland.menu"
        },
        {
          "id": "archisland.workspaces"
        }
      ],
      "center": [
        {
          "id": "archisland.indicators"
        },
        {
          "id": "archisland.elsewhen"
        },
        {
          "id": "archisland.clock",
          "format": "dddd HH:mm",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "verticalFormat": "HH\n\u2014\nmm"
        },
        {
          "id": "archisland.keyboard-layout"
        },
        {
          "id": "archisland.weather"
        },
        {
          "id": "archisland.system-update"
        }
      ],
      "right": [
        {
          "id": "archisland.tray"
        },
        {
          "id": "archisland.agents"
        },
        {
          "id": "archisland.bluetooth"
        },
        {
          "id": "archisland.network"
        },
        {
          "id": "archisland.audio"
        },
        {
          "id": "archisland.monitor"
        },
        {
          "id": "archisland.power"
        }
      ]
    }
  },
  "plugins": []
}
